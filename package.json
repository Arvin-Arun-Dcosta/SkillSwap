{
  "name": "skillswap",
  "version": "2.0.0",
  "private": true,
  "description": "SkillSwap: peer-to-peer skill exchange with real-time learning rooms",
  "author": "Arvin Arun Dcosta",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Arvin-Arun-Dcosta/SkillSwap.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "shared",
    "server",
    "client",
    "e2e"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c teal,yellow \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client && npm run build -w server",
    "start": "npm run start -w server",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "e2e": "npm run e2e -w e2e",
    "seed": "npm run seed -w server",
    "migrate": "npm run migrate -w server",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run build",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "concurrently": "^10.0.6",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix --max-warnings 0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,css,html,yml,yaml}": "prettier --write"
  }
}
