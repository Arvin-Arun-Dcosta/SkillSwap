# Copy to .env at the repository root. Values here are safe development defaults.
# The server validates this file at startup and refuses to boot when something required is missing.

NODE_ENV=development

# Port for the API (and, in production, the built client).
PORT=5000

# MongoDB connection string. Required in production.
# Leave empty in development to run against an in-memory MongoDB seeded with demo data.
MONGODB_URI=

# Secret used to sign session cookies. Required, minimum 32 characters.
# Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# Session lifetime in days.
SESSION_DAYS=7

# Browser origins allowed to call the API with credentials (comma separated).
# In production the client is served by the API itself, so this is usually just the public URL.
CLIENT_ORIGINS=http://localhost:5173

# Public base URL of the site (no trailing slash), used for the canonical URL, sitemap and share
# links. Optional in development; set it in production, e.g. https://skillswap.example.com.
# When it starts with https://, HSTS and upgrade-insecure-requests are switched on.
PUBLIC_URL=

# One-click demo accounts. Defaults to true in development and false in production.
DEMO_MODE=

# Seed demo data at startup when the database has no members. The in-memory development database
# is always seeded. Demo accounts share a published password: only use this for a public demo.
SEED_DEMO_DATA=

# Public demo only: once the demo data is this many hours old, DELETE ALL DATA (including members
# who signed up) and seed a fresh copy. Checked at startup and hourly, skipped while anyone is
# connected. Implies SEED_DEMO_DATA. A database without demo accounts is never reset. 0 = never.
DEMO_RESET_HOURS=0

# ICE servers for WebRTC as a JSON array. Add a TURN server for calls across strict NATs.
ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]

# Directory for files shared in sessions.
UPLOAD_DIR=./server/uploads

# Maximum size of a shared file, in megabytes.
MAX_UPLOAD_MB=10

# Set to true when running behind a reverse proxy that sets X-Forwarded-* headers.
TRUST_PROXY=false

# Send the session cookie over HTTPS only. Defaults to true in production. Set to false only to
# try a production build over plain HTTP on a machine that is not localhost.
COOKIE_SECURE=

# Log level: fatal, error, warn, info, debug, trace, silent.
# Defaults to debug in development, info in production, silent in tests.
# LOG_LEVEL=info

# bcrypt cost factor for password hashes (4-15). Defaults to 12 (4 in tests).
# BCRYPT_ROUNDS=12

# --- Tooling only (not read by the server) -------------------------------------------------------
# These are read from the shell, not from this file; listed here so every variable is documented.
#
# VITE_DEV_API   Where the Vite dev server proxies /api and /socket.io (default http://localhost:5000).
# E2E_PORT       Port of the server Playwright starts for end-to-end tests (default 5055).
#                Avoid ports Chrome blocks, such as 5060 and 5061.
